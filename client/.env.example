# Public API base URL (used by the client to call the Express API).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Data source for the directory, athlete profile, and community surfaces.
# `mock` (default) renders from the client's local mock modules — GitHub Pages /
# static exports keep working with no API dependency. `api` fetches live data
# client-side from NEXT_PUBLIC_API_BASE_URL (requires a running, seeded API).
NEXT_PUBLIC_DATA_SOURCE=mock

# Static-export mode for the custom-domain S3/CloudFront deploy (test.athletearc.ca).
# `true` produces a plain `output: 'export'` build (client/out/) with NO basePath/assetPrefix,
# served at the domain root. Leave unset for the default Next server build (local dev, CI).
# Distinct from the legacy GitHub Pages export (GITHUB_PAGES=true), which adds a /athlete_dreams basePath.
STATIC_EXPORT=false
