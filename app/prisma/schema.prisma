// FAD Network — primary data model.
//
// Account model: User → Team (individual + team support). No workspace tier.
// Every athlete has exactly one User and exactly one personal Team (auto-created on sign-up).
// Multi-member teams (e.g., an athlete + their manager/coach) join via TeamMembership rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.Citext
  passwordHash    String
  displayName     String
  avatarUrl       String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  athleteProfile     AthleteProfile?
  athleteFollows     AthleteFollow[]
  teamMemberships    TeamMembership[]
  teamInvitations    TeamInvitation[] @relation("InvitedBy")
  sessions           AuthSession[]
  donations          Donation[]
  brandMemberships   BrandMembership[]
  platformRoleAssignments PlatformRoleAssignment[]
  communityReactions CommunityReaction[]

  @@map("users")
}

model AuthSession {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  refreshTokenHash    String
  userAgent           String?
  ipAddress           String?
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

enum PlatformRole {
  ATHLETE
  SUPPORTER
  BRAND
  ADMIN
}

model PlatformRoleAssignment {
  id     String        @id @default(uuid()) @db.Uuid
  userId String        @db.Uuid
  role   PlatformRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("platform_role_assignments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Team membership (no workspace tier)
// ─────────────────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  isPersonal  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  memberships TeamMembership[]
  invitations TeamInvitation[]

  @@map("teams")
}

enum TeamRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

model TeamMembership {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  teamRole  TeamRole
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_memberships")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  DECLINED
  EXPIRED
}

model TeamInvitation {
  id                  String           @id @default(uuid()) @db.Uuid
  teamId              String           @db.Uuid
  invitedByUserId     String           @db.Uuid
  inviteeEmail        String
  invitedTeamRole     TeamRole
  invitationStatus    InvitationStatus @default(PENDING)
  invitationTokenHash String           @unique
  invitationExpiresAt DateTime
  createdAt           DateTime         @default(now())
  acceptedAt          DateTime?

  team        Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy   User @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([inviteeEmail])
  @@map("team_invitations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Athlete domain
// ─────────────────────────────────────────────────────────────────────────────

enum SportCategory {
  RUNNING
  TRIATHLON
  CYCLING
  SWIMMING
  CLIMBING
  SKIING
  SNOWBOARDING
  HOCKEY
  SOCCER
  BASKETBALL
  TRACK_AND_FIELD
  CROSS_COUNTRY_SKIING
  OTHER
}

enum AthleteProfileStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AthleteLevel {
  ELITE
  COMPETITIVE
  EVERYDAY
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AthleteResultKind {
  HIGHLIGHT
  RACE
  MILESTONE
}

enum AthleteStoryChapterIcon {
  MEDAL
  HEART
  HISTORY
  TROPHY
  FLAG
  TIMER
  BOOK
  GROUPS
}

enum AthleteStoryChapterTone {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum AthleteMediaRole {
  HERO
  PROFILE
  GALLERY
  RESULT
  STORY_CHAPTER
  TRAINING
  FEATURED_VIDEO
}

enum CommunityFeedTargetType {
  ATHLETE_RESULT
  ATHLETE_EVENT
  ATHLETE_TRAINING_SNAPSHOT
  ATHLETE_PROFILE_MILESTONE
}

enum ReactionKind {
  CHEER
}

model AthleteProfile {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @unique @db.Uuid
  athleteSlug           String?       @unique
  fullName              String?
  profileStatus         AthleteProfileStatus @default(DRAFT)
  publishedAt           DateTime?
  profileVersion        Int           @default(0)
  headline              String?
  tagline               String?
  bio                   String?
  storyIntro            String?
  storyBody             String[]      @default([])
  primarySport          SportCategory?
  secondarySports       SportCategory[] @default([])
  athleteLevel          AthleteLevel?
  disciplineLabel       String?
  hometown              String?
  countryCode           String?       @db.VarChar(2)
  values                String[]      @default([])
  arcSubtitle           String?
  roadmapTitle          String?
  supportEnabled        Boolean       @default(false)
  backCtaBlurb          String?
  socialInstagramHandle String?
  socialTwitterHandle   String?
  socialStravaUrl       String?
  heroMediaUrl          String?
  profileImageUrl       String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coreValues      AthleteCoreValue[]
  storyChapters   AthleteStoryChapter[]
  personalBests   AthletePersonalBest[]
  results         AthleteResult[]
  trainingSnapshots AthleteTrainingSnapshot[]
  powerProfile    AthletePowerProfile?
  profileMilestones AthleteProfileMilestone[]
  accomplishments AthleteAccomplishment[]
  media           AthleteMedia[]
  events          AthleteEvent[]
  follows         AthleteFollow[]
  campaigns       Campaign[]
  sponsorshipInquiries SponsorshipInquiry[]

  @@index([profileStatus, primarySport])
  @@index([profileStatus, countryCode])
  @@index([profileStatus, createdAt])
  @@index([publishedAt])
  @@map("athlete_profiles")
}

model AthleteCoreValue {
  id        String   @id @default(uuid()) @db.Uuid
  athleteId String   @db.Uuid
  title     String
  body      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, sortOrder])
  @@map("athlete_core_values")
}

model AthleteAccomplishment {
  id          String   @id @default(uuid()) @db.Uuid
  athleteId   String   @db.Uuid
  title       String
  description String?
  occurredOn  DateTime? @db.Date
  createdAt   DateTime @default(now())

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@map("athlete_accomplishments")
}

enum MediaKind {
  IMAGE
  VIDEO
}

model AthleteMedia {
  id                    String            @id @default(uuid()) @db.Uuid
  athleteId             String            @db.Uuid
  mediaUrl              String
  mediaKind             MediaKind
  mediaRole             AthleteMediaRole  @default(GALLERY)
  thumbnailUrl          String?
  altText               String?
  caption               String?
  durationLabel         String?
  relatedAthleteResultId String?           @db.Uuid
  relatedStoryChapterId String?           @db.Uuid
  sortOrder             Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?

  athlete     AthleteProfile       @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  result      AthleteResult?       @relation(fields: [relatedAthleteResultId], references: [id], onDelete: SetNull)
  storyChapter AthleteStoryChapter? @relation(fields: [relatedStoryChapterId], references: [id], onDelete: SetNull)

  @@index([athleteId, mediaRole, sortOrder])
  @@index([relatedAthleteResultId])
  @@index([relatedStoryChapterId])
  @@map("athlete_media")
}

model AthleteEvent {
  id               String    @id @default(uuid()) @db.Uuid
  athleteId        String    @db.Uuid
  eventName        String
  eventLocation    String?
  eventStartDate   DateTime? @db.Date
  eventEndDate     DateTime? @db.Date
  eventDateLabel   String?
  eventDescription String?
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  athlete    AthleteProfile           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sourceLinks AthleteEventSourceLink[]
  campaigns  Campaign[]

  @@index([athleteId, eventStartDate])
  @@index([athleteId, sortOrder])
  @@map("athlete_events")
}

model AthleteEventSourceLink {
  id             String @id @default(uuid()) @db.Uuid
  athleteEventId String @db.Uuid
  label          String
  href           String
  sortOrder      Int    @default(0)

  event AthleteEvent @relation(fields: [athleteEventId], references: [id], onDelete: Cascade)

  @@index([athleteEventId, sortOrder])
  @@map("athlete_event_source_links")
}

model AthletePersonalBest {
  id                 String             @id @default(uuid()) @db.Uuid
  athleteId          String             @db.Uuid
  label              String
  value              String
  sourceUrl          String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, sortOrder])
  @@index([athleteId, verificationStatus])
  @@map("athlete_personal_bests")
}

model AthleteResult {
  id                 String             @id @default(uuid()) @db.Uuid
  athleteId          String             @db.Uuid
  resultKind         AthleteResultKind
  title              String
  resultText         String
  eventDate          DateTime?          @db.Date
  eventDateLabel     String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  athlete     AthleteProfile            @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sourceLinks AthleteResultSourceLink[]
  media       AthleteMedia[]

  @@index([athleteId, resultKind, sortOrder])
  @@index([athleteId, eventDate])
  @@index([athleteId, verificationStatus])
  @@map("athlete_results")
}

model AthleteResultSourceLink {
  id              String @id @default(uuid()) @db.Uuid
  athleteResultId String @db.Uuid
  label           String
  href            String
  sortOrder       Int    @default(0)

  result AthleteResult @relation(fields: [athleteResultId], references: [id], onDelete: Cascade)

  @@index([athleteResultId, sortOrder])
  @@map("athlete_result_source_links")
}

model AthleteStoryChapter {
  id          String                  @id @default(uuid()) @db.Uuid
  athleteId   String                  @db.Uuid
  eraLabel    String
  title       String
  body        String
  chapterIcon AthleteStoryChapterIcon
  chapterTone AthleteStoryChapterTone
  imageUrl    String?
  isCurrent   Boolean                 @default(false)
  sortOrder   Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  deletedAt   DateTime?

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  media   AthleteMedia[]

  @@index([athleteId, sortOrder])
  @@map("athlete_story_chapters")
}

model AthleteTrainingSnapshot {
  id                       String   @id @default(uuid()) @db.Uuid
  athleteId                String   @db.Uuid
  weeklyDistanceLabel      String?
  weeklyTimeLabel          String?
  weeklyElevationGainLabel String?
  weeklyLoadLabel          String?
  latestSessionTitle       String?
  latestSessionMeta        String?
  capturedAt               DateTime @default(now())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  deletedAt                DateTime?

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, capturedAt])
  @@map("athlete_training_snapshots")
}

model AthletePowerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  athleteId   String   @unique @db.Uuid
  ftpWatts    String?
  wattsPerKg  String?
  riderWeight String?
  riderType   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  athlete AthleteProfile     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  peaks   AthletePowerPeak[]

  @@map("athlete_power_profiles")
}

model AthletePowerPeak {
  id                    String @id @default(uuid()) @db.Uuid
  athletePowerProfileId String @db.Uuid
  label                 String
  watts                 String
  sortOrder             Int    @default(0)

  powerProfile AthletePowerProfile @relation(fields: [athletePowerProfileId], references: [id], onDelete: Cascade)

  @@index([athletePowerProfileId, sortOrder])
  @@map("athlete_power_peaks")
}

model AthleteProfileMilestone {
  id         String    @id @default(uuid()) @db.Uuid
  athleteId  String    @db.Uuid
  headline   String
  detail     String?
  photoUrl   String?
  occurredAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, occurredAt])
  @@map("athlete_profile_milestones")
}

model AthleteFollow {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  athleteId  String   @db.Uuid
  followedAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([userId, athleteId])
  @@index([athleteId, followedAt])
  @@index([userId, followedAt])
  @@map("athlete_follows")
}

model CommunityReaction {
  id           String                  @id @default(uuid()) @db.Uuid
  userId       String                  @db.Uuid
  targetType   CommunityFeedTargetType
  targetId     String                  @db.Uuid
  reactionKind ReactionKind            @default(CHEER)
  createdAt    DateTime                @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([userId, createdAt])
  @@map("community_reactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Campaigns & Donations
// ─────────────────────────────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  ACTIVE
  FUNDED
  COMPLETED
  ARCHIVED
}

enum CampaignType {
  EVENT
  SEASON
  GEAR
  TRAVEL
  TRAINING
  GENERAL
}

model Campaign {
  id                 String         @id @default(uuid()) @db.Uuid
  campaignSlug       String         @unique
  athleteId          String         @db.Uuid
  athleteEventId     String?        @db.Uuid
  campaignTitle      String
  campaignType       CampaignType
  campaignStatus     CampaignStatus @default(DRAFT)
  campaignStory      String
  targetAmountCents  Int
  raisedAmountCents  Int            @default(0)
  supporterCount     Int            @default(0)
  closesAt           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  athlete      AthleteProfile     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteEvent AthleteEvent?      @relation(fields: [athleteEventId], references: [id], onDelete: SetNull)
  costLines    CampaignCostLine[]
  donations    Donation[]
  updates      CampaignUpdate[]

  @@index([athleteId, campaignStatus])
  @@index([campaignStatus])
  @@index([campaignStatus, createdAt])
  @@map("campaigns")
}

model CampaignCostLine {
  id          String @id @default(uuid()) @db.Uuid
  campaignId  String @db.Uuid
  label       String
  amountCents Int
  notes       String?
  sortOrder   Int    @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sortOrder])
  @@map("campaign_cost_lines")
}

model CampaignUpdate {
  id           String   @id @default(uuid()) @db.Uuid
  campaignId   String   @db.Uuid
  updateTitle  String
  updateBody   String
  createdAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@map("campaign_updates")
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  REFUNDED
  FAILED
}

model Donation {
  id                    String         @id @default(uuid()) @db.Uuid
  campaignId            String         @db.Uuid
  supporterUserId       String?        @db.Uuid
  supporterDisplayName  String
  supporterEmail        String?
  donationAmountCents   Int
  donationMessage       String?
  donationStatus        DonationStatus @default(PENDING)
  isAnonymous           Boolean        @default(false)
  paymentProviderRef    String?        @unique
  createdAt             DateTime       @default(now())

  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  supporterUser User?    @relation(fields: [supporterUserId], references: [id], onDelete: SetNull)

  @@index([campaignId, donationStatus])
  @@index([supporterUserId])
  @@map("donations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Brands & Ambassador Programs
// ─────────────────────────────────────────────────────────────────────────────

model Brand {
  id           String   @id @default(uuid()) @db.Uuid
  brandSlug    String   @unique
  brandName    String
  brandWebsite String?
  brandLogoUrl String?
  brandBio     String?
  brandValues  String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  memberships          BrandMembership[]
  sponsorshipInquiries SponsorshipInquiry[]
  ambassadorPrograms   AmbassadorProgram[]

  @@map("brands")
}

enum BrandRole {
  OWNER
  MARKETING
  VIEWER
}

model BrandMembership {
  id        String    @id @default(uuid()) @db.Uuid
  brandId   String    @db.Uuid
  userId    String    @db.Uuid
  brandRole BrandRole
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([brandId, userId])
  @@map("brand_memberships")
}

enum SponsorshipStatus {
  INQUIRY
  NEGOTIATING
  ACTIVE
  ENDED
  DECLINED
}

model SponsorshipInquiry {
  id                String            @id @default(uuid()) @db.Uuid
  brandId           String            @db.Uuid
  athleteId         String            @db.Uuid
  sponsorshipStatus SponsorshipStatus @default(INQUIRY)
  inquiryMessage    String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  brand   Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([athleteId])
  @@map("sponsorship_inquiries")
}

model AmbassadorProgram {
  id                  String   @id @default(uuid()) @db.Uuid
  brandId             String   @db.Uuid
  programName         String
  programDescription  String?
  isFadManaged        Boolean  @default(false)
  intakeFormConfig    Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  brand        Brand                       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  applications AmbassadorApplication[]

  @@index([brandId])
  @@map("ambassador_programs")
}

enum AmbassadorApplicationStatus {
  SUBMITTED
  IN_REVIEW
  SHORTLISTED
  APPROVED
  REJECTED
  WITHDRAWN
}

model AmbassadorApplication {
  id                          String                       @id @default(uuid()) @db.Uuid
  ambassadorProgramId         String                       @db.Uuid
  applicantAthleteId          String                       @db.Uuid
  ambassadorApplicationStatus AmbassadorApplicationStatus @default(SUBMITTED)
  applicationPayload          Json
  reviewNotes                 String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  program AmbassadorProgram @relation(fields: [ambassadorProgramId], references: [id], onDelete: Cascade)

  @@index([ambassadorProgramId, ambassadorApplicationStatus])
  @@map("ambassador_applications")
}
