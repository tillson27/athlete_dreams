# Express server
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://fad:fad@localhost:5432/fad_dev?schema=public

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# Testing — set to 1 only when DATABASE_URL points at a reachable Postgres so the
# health-ready integration test runs the real SELECT 1 probe; leave unset to skip it.
RUN_DB_TESTS=
