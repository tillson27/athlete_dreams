# Express server
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://fad:fad@localhost:5432/fad_dev?schema=public

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
APP_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Invite gate — comma-separated allowlist enforced at sign-up AND sign-in.
# Entries are exact emails (a@b.c) or whole domains (@b.c), case-insensitive.
# Leave empty/unset for open access (local dev default).
SIGNUP_EMAIL_ALLOWLIST=

# Testing — set to 1 only when DATABASE_URL points at a reachable Postgres so the
# health-ready integration test runs the real SELECT 1 probe; leave unset to skip it.
RUN_DB_TESTS=
