# Express server
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://fad:fad@localhost:5432/fad_dev?schema=public

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
APP_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Invite gate — comma-separated allowlist enforced at sign-up AND sign-in.
# Entries are exact emails (a@b.c) or whole domains (@b.c), case-insensitive.
# Leave empty/unset for open access (local dev default).
SIGNUP_EMAIL_ALLOWLIST=

# Testing — set to 1 only when DATABASE_URL points at a reachable Postgres so the
# health-ready integration test runs the real SELECT 1 probe; leave unset to skip it.
RUN_DB_TESTS=

# Stripe Connect (non-custodial: Standard accounts, direct charges, zero platform fee).
# Test-mode secret key (sk_test_...). Never commit a live key; keys are never logged.
STRIPE_SECRET_KEY=sk_test_replace-me
# Connect webhook signing secret (whsec_...). From the Stripe CLI (`stripe listen`)
# or the Connect webhook endpoint. Used to verify the raw request body signature.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace-me
# Athlete onboarding (Account Links) return/refresh URLs — single-use hosted flow.
STRIPE_ACCOUNT_ONBOARDING_RETURN_URL=http://localhost:3000/athletes/me/manage?stripe_return=1
STRIPE_ACCOUNT_ONBOARDING_REFRESH_URL=http://localhost:3000/athletes/me/manage?stripe_refresh=1
# Donor Checkout return URLs. Success carries ?session_id={CHECKOUT_SESSION_ID}&athlete=<slug>.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/donate/thanks
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000
# Minimum donation in integer cents (500 = $5 CAD). Enforced server-side.
DONATION_MINIMUM_CENTS=500
# Default currency for donations (ISO code, lowercase for Stripe).
DEFAULT_CURRENCY=cad
